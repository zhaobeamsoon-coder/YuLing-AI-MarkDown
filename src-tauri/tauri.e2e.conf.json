{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuLing MD E2E",
  "identifier": "ai.yuling.md.e2e",
  "build": {
    "beforeBuildCommand": "VITE_YULING_E2E=1 pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e-main-capability",
          "description": "Isolated permissions for the feature-gated E2E application",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:allow-watch",
            "fs:allow-unwatch",
            "clipboard-manager:allow-write-text",
            "clipboard-manager:allow-write-html",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "targets": ["app"],
    "fileAssociations": []
  }
}
